{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "simple-chat",
  "version": "0.1.0",
  "identifier": "com.simplechat.p2p",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "SimpleChat Overlay",
        "url": "index.html?window=overlay",
        "width": 360,
        "height": 500,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "main",
        "title": "SimpleChat P2P - チャット履歴・接続設定",
        "url": "index.html?window=main",
        "width": 1140,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "transparent": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
